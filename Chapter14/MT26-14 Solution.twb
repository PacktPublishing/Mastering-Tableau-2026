        <calculation class='tableau' formula='SCRIPT_REAL(&quot; &#10;x &lt;- lm(.arg1 ~ .arg2 + .arg3 + .arg4) &#10;x$residuals&quot;, &#10;SUM(Profit),COUNT(Quantity), SUM(Sales), AVG(Discount)&#10;)'>
