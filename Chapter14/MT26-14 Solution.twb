    <worksheet lock-updates='true' name='Sentiment Analysis'>
      <table>
        <view>
          <datasources>
            <datasource caption='Headlines' name='federated.0qb9yla0ib6tdi13rlq9t1qssa8x' />
          </datasources>
          <datasource-dependencies datasource='federated.0qb9yla0ib6tdi13rlq9t1qssa8x'>
            <column caption='Sentiment Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3011008254073847817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#10;from nltk.sentiment import SentimentIntensityAnalyzer &#10;&#10;scores = []&#10;&#10;text = _arg1&#10;sid = SentimentIntensityAnalyzer() &#10;&#10;for word in text:&#10;    ss = sid.polarity_scores(word) &#10;scores.append(ss[&apos;compound&apos;])&#10;&#10;return scores &#10;&quot;&#10;&#10;,ATTR([headline_text])&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Color Coding' datatype='string' name='[Calculation_3011008254075645962]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF ([Calculation_3011008254073847817] &gt;= 0, &apos;Positivity&apos;, &apos;Negativity&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[headline_text]' role='dimension' type='nominal' />
            <column-instance column='[publish_date]' derivation='Month' name='[mn:publish_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[headline_text]' derivation='None' name='[none:headline_text:nk]' pivot='key' type='nominal' />
            <column-instance column='[publish_date]' derivation='None' name='[none:publish_date:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[publish_date]' role='dimension' type='ordinal' />
