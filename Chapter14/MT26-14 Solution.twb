      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Quantiles' datatype='real' name='[Calculation_502081045950132228]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#10;x &lt;- .arg1;&#10;y &lt;- .arg2[1];&#10;m &lt;- c(1:y)/y;&#10;n &lt;- length(x);&#10;z &lt;- c(1:n); for (i in c(1:n)) z[i] &lt;- 0;&#10;for (j in c(1:y)) for (i in c(1:n)) z[i] &lt;- if (x[i] &lt;= quantile(x,m)[j] &amp;&amp; z[i] == 0 ) j else z[i];&#10;z;&quot;&#10;, SUM(Sales), [Parameters].[Parameter 3])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Percentile' datatype='boolean' name='[Calculation_502081045951127559]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_PERCENTILE(SUM([Sales])) &lt; [Parameters].[Parameter 4] AND&#10;RANK_PERCENTILE(SUM([Sales])) &gt; [Parameters].[Select Percentile Bottom Range (copy)_502081045951008774]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_502081045953163272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Diff' datatype='real' default-format='p0.00%' name='[Calculation_502081046279528457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(Profit)/[Calculation_99079248012443654]-1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tab Avg' datatype='real' name='[Calculation_99079248008609792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM(Sales))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tab Median' datatype='real' name='[Calculation_99079248008675329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(SUM(Sales))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tab Stdev' datatype='real' name='[Calculation_99079248008724482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_STDEV(SUM(Sales))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='R - mean' datatype='integer' name='[Calculation_99079248009166851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_INT(&quot;mean(.arg1)&quot;, SUM(Sales))'>
          <table-calc ordering-type='Rows' />
