              <table-calc ordering-field='[federated.0qb9yla0ib6tdi13rlq9t1qssa8x].[publish_date]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_3011008254075645962]' derivation='User' name='[usr:Calculation_3011008254075645962:nk:7]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
              <table-calc field='[federated.0qb9yla0ib6tdi13rlq9t1qssa8x].[Calculation_3011008254073847817]' ordering-field='[federated.0qb9yla0ib6tdi13rlq9t1qssa8x].[publish_date]' ordering-type='Field' />
