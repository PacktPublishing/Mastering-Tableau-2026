      <column caption='Profit_Expected' datatype='real' name='[Calculation_99079248012443654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_REAL(&quot;&#10;a &lt;- .arg1;&#10;b &lt;- .arg2;&#10;c &lt;- .arg3;&#10;d &lt;- .arg4;&#10;&#10;x &lt;- lm(a ~ b + c + d) &#10;x$fitted&#10;&#10;&quot;, &#10;SUM(Profit), COUNT(Quantity), SUM(Sales) , AVG(Discount)&#10;)'>
