      <column datatype='real' name='[Birth Rate]' role='measure' type='quantitative' />
      <column caption='Cluster' datatype='integer' name='[Calculation_502081045947469824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SCRIPT_INT(&quot;&#10;m &lt;- cbind(.arg1, .arg2); &#10;kmeans(m,4,nstart=5)$cluster&quot;,&#10;AVG( [Life Expectancy Female] ), AVG([Life Expectancy Male]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
